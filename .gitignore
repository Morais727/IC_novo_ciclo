.venv/
.venv-*/
venv/
env/
wheels/
__pycache__/
*.pyc
*.pyo
*.so
*.o

# ---- datasets e caches ----
data/
data_cache/
cifar*/
**/DADOS_BRUTOS/
**/MNIST/
**/FashionMNIST/
**/cifar-10-batches-py/
*-ubyte
*-ubyte.gz

