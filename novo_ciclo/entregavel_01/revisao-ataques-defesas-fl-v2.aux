\newlabel{fig:backdoor}{{1}{6}{\textbf {Resiliência contra Backdoors Furtivos (Edge-case PGD) no CIFAR-10.} O indicador Multi-métrica com branqueamento (Ours) neutraliza a taxa de sucesso do backdoor (BA \%) para 3,06\% sem comprometer a acurácia do modelo principal (MA \%), superando de forma consistente defesas como FLAME e FoolsGold}{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Desempenho sob Ataques Bizantinos e Label Skewness (Dirichlet 2-classes).} O BOBA alcança 69,2\% de acurácia no pior cenário de ataque bizantino no CIFAR-10, mantendo a estabilidade e imparcialidade frente ao colapso de baselines como Krum (31,8\%) e Trimmed Mean (14,1\%) sob severo não-IID.}}{7}{figure.caption.2}\protected@file@percent }
