\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Resiliência contra Backdoors Furtivos (Edge-case PGD) no CIFAR-10.} O indicador Multi-métrica com branqueamento (Ours) neutraliza a taxa de sucesso do backdoor (BA \%) para 3,06\% sem comprometer a acurácia do modelo principal (MA \%), superando de forma consistente defesas como FLAME e FoolsGold.}}{6}{figure.caption.1}\protected@file@percent }
